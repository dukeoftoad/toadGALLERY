<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- r29 (Issue #14 gate; contract section 4.5): the editor NEVER
         requires network. There is deliberately NO INTERNET permission here
         (not even an allowlisted one) and the module's build-time
         merged-manifest gate fails the build if a dependency ever injects
         it. The gallery's ADR-0020 models.ente.com grant belongs to the
         GALLERY app only. -->

    <!-- Pre-Q MediaStore inserts (the save-copy export) need the legacy
         external-storage WRITE grant; on API 29+ own-contribution inserts
         into Pictures need no permission at all, so this is capped at
         maxSdkVersion=28. It is requested at export time only, on devices
         where it applies. A storage permission, never a network one. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- r41 (the CI merge-gate catch): the onnxruntime-android AAR's own
         manifest declares INTERNET (its packaging carries the sample
         convenience declaration); the merge gate caught the merged
         manifest gaining it on the FIRST merge-gate run. The fix is a
         HARD STRIP, never an allowlist: this directive removes the
         permission at manifest-merge time, so the merged manifest this
         gate reads (and the device installs) carries NO INTERNET at all;
         the app cannot even open a socket. The runtime opens no
         socket of its own (the JVM source scan asserts no network
         classes in our code; the instrumented egress probe stays the
         physical-device gate per ADR-0016). This is a strip directive,
         NOT a permission request: nothing is ever granted. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:appCategory="image"
        android:icon="@mipmap/editor_ic_launcher"
        android:roundIcon="@mipmap/editor_ic_launcher_round"
        android:label="@string/editor_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <!-- r46 (the contract-discovery hardening round): the
             APPLICATION-level contract marker, the fallback the hardened
             gallery resolver reads when the ACTIVITY-level meta-data is
             unavailable on some PackageManager paths (a query-result
             ActivityInfo bundle is not guaranteed populated across Android
             versions and query flags; a direct getApplicationInfo call
             reliably fills only this level). Precedence is
             activity-first, application-second (EditorVersionMetadata.pick,
             the shared pure rule), so this marker changes nothing when the
             activity-level read is healthy and only rescues the
             population-gap paths. The two activity-level markers below stay
             exactly as they were: the image surface keeps declaring 1 (the
             byte-identical v1 wire), the video surface 2. -->
        <meta-data
            android:name="org.toadgallery.contract.EDIT"
            android:value="2" />

        <!-- The contract launch activity (spec section 1): exported, filtered
             on the contract action, and carrying the v1 contract-version
             meta-data the gallery's negotiator reads. The activity supports
             exactly the formats the prototype decodes (JPEG / PNG / WebP /
             HEIC); everything else returns ERROR_UNSUPPORTED per the spec.
             The image surface declares contract v1: the v2 additions (the
             optional media-kind extra, the video surface below) are purely
             additive, so the image wire is byte-identical to v1. -->
        <activity
            android:name=".EditActivity"
            android:exported="true"
            android:label="@string/editor_app_name">
            <intent-filter>
                <action android:name="org.toadgallery.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
            </intent-filter>

            <!-- The contract version marker: the value the gallery's
                 EditorVersionNegotiator resolves. Bumped only per the
                 contract's additive-versioning rule. -->
            <meta-data
                android:name="org.toadgallery.contract.EDIT"
                android:value="1" />
        </activity>

        <!-- The r42 video launch activity (the additive contract v2 surface;
             ADR-0012; docs/phase-10/video-editor.md): the same contract
             action filtered on VIDEO mimes. Its meta-data declares 2: the
             video ability IS the v2 addition, so the gallery's video query
             negotiates v2 against exactly this activity (an image query
             resolves the v1 image surface above). The v1 input set is what
             the media3 Transformer pipeline honestly re-encodes on-device:
             MP4 / MOV / 3GP (H.264/HEVC video, AAC audio); the output is
             always MP4. Zero network; zero new permissions. -->
        <activity
            android:name=".video.VideoEditActivity"
            android:exported="true"
            android:label="@string/editor_video_app_name">
            <intent-filter>
                <action android:name="org.toadgallery.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/mp4" />
                <data android:mimeType="video/quicktime" />
                <data android:mimeType="video/3gpp" />
            </intent-filter>

            <meta-data
                android:name="org.toadgallery.contract.EDIT"
                android:value="2" />
        </activity>
    </application>

</manifest>
