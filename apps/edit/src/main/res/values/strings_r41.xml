    <string name="editor_ai_erase_remove">Remove</string>
    <string name="editor_ai_erase_too_small">The painted area was too small to erase; paint a larger area and try again.</string>
    <string name="editor_ai_erase_models_missing">The magic-erase models are missing from this build; the feature is unavailable.</string>

