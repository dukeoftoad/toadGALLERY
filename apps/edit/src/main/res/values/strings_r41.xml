<?xml version="1.0" encoding="utf-8"?>
<!-- r41 (Phase 10 sub-scope A): the Edit v3 AI surfaces - magic erase,
     sky replacement, bokeh and the OPT-IN face retouch. The copy is honest
     per ADR-0010: every AI edit runs entirely on this device with compact
     bundled models, so the quality is bounded - a small on-device model,
     not a server-side diffusion service - and the strings say so plainly
     without apologising. The five bundled skies are project-authored
     parametric code; their display names (Day clear, Dusk, Night,
     Overcast, Golden hour) are proper nouns in the BundledSkies registry,
     not resources; an imported sky's chip label is its derived id. The
     retouch consent dialog states the ADR-0010 section 5 trio: what the
     model does, that it runs on-device only, and that no face data leaves
     the device. -->
<resources>
    <!-- The sections -->
    <string name="editor_section_ai_erase">Magic erase</string>
    <string name="editor_section_ai_sky">Sky</string>
    <string name="editor_section_ai_bokeh">Bokeh</string>
    <string name="editor_section_ai_retouch">Face retouch</string>
    <string name="editor_settings">Settings</string>

    <!-- Magic erase: the third paint mode (the exclusive duality's third
         member) + its honest bounds. -->
    <string name="editor_ai_erase_mode">Erase</string>
    <string name="editor_ai_erase_hint">Paint over what you want removed. Erasing runs once, on this device, when you lift your finger - with a compact on-device model, not a server service, so results are good but bounded.</string>
