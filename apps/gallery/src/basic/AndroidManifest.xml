<?xml version="1.0" encoding="utf-8"?>
<!-- r50 (the dual-flavor audit): the BASIC flavor's manifest overlay.
     The basic build is "the offline-first core gallery" (BuildShape's
     words) with the ENTIRE AI surface gated out — the only consumer
     of the INTERNET permission in the app is the ADR-0020 model
     download (HttpModelDownloader via ModelProvisioner), which is
     unreachable in basic (every Settings AI card and index worker is
     BuildShape-gated off). Main's manifest declaration therefore
     shipped an unusable permission in every basic APK, contradicting
     basic's own contract. The overlay REMOVES it from the merged basic
     manifest (the engine-family flavors keep it — they download
     models); the r50-hardened privacy gate in build.gradle.kts fails
     the build if INTERNET ever reappears in a basic* merged manifest,
     allowlist or not. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
</manifest>
