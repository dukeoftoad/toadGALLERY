<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 3: media access for the Photos timeline (issue #25).
         API 33+ uses the granular READ_MEDIA_* permissions; pre-33 falls back
         to READ_EXTERNAL_STORAGE capped at maxSdkVersion=32. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- r22 (ADR-0020 §1): the model-fetch-only INTERNET grant, landed with
         the r22 downloader (HttpModelDownloader). The app may open network
         connections for exactly ONE purpose: downloading the pinned AI model
         assets (ModelManifest) from the single allowlisted host pinned in
         ml/engine/HttpModelDownloader.kt (MODEL_HOST), every byte verified
         (size + SHA-256) before install. This amends ADR-0014's
         offline-by-construction for model fetches ONLY: no account, no
         telemetry, no crash reporting, no tile/vector/config fetches of any
         other kind; media, embeddings and indexes never cross the network.
         The build-time merged-manifest gate (InternetPermissionGateTask)
         enforces the allowlist-file protocol; the JVM/instrumented privacy
         suites pin the host and the URL surface. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 4: EXIF location consent (audit decision #1; see the
         data/media/location package and ExifReader's KDoc). A runtime
         ("dangerous") permission from API 29 only; there is no
         maxSdkVersion form for a MINIMUM API range, so it is declared
         unconditionally and pre-29 devices simply ignore the unknown
         name. The runtime request is gated in code
         (MediaLocationAccess.required(), false below 29), so nothing is
         ever ASKED on devices where the permission does not exist. The
         grant decides only whether GPS coordinates are DISPLAYED; the
         coordinates never leave the device and no network surface exists
         to carry them (ADR-0014). -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- r24 (WorkManager, Workstream 5): the background face-index queue
         uses androidx.work for scheduling + process-death persistence. That
         library's own manifest injects four permissions into the MERGED
         manifest; two of them are declined here with tools:node=remove and
         two are accepted (documented in docs/phase-2/privacy-gate.md, r24
         note):
         * DECLINED ACCESS_NETWORK_STATE — the queue NEVER uses
           network-constrained work, so the connectivity observer is dead
           weight; stripping it keeps the app's network-capability surface
           at exactly the ADR-0020 model-fetch INTERNET grant.
         * DECLINED FOREGROUND_SERVICE — r24 runs plain background
           workers only (no setForeground, no expedited); a future
           user-visible indexing notification round adds this back
           deliberately, with its own ADR note.
         * ACCEPTED WAKE_LOCK (merged from the library) — WorkManager's
           execution-guarantee plumbing for the queue's workers.
         * ACCEPTED RECEIVE_BOOT_COMPLETED (merged from the library) —
           rescheduling persisted work after a reboot, which extends the
           queue's resume contract; neither accepted permission is a
           network permission, so the ADR-0014 gate is unaffected.
         The entries below are MERGER REMOVAL MARKERS, not grants: they
         push permissions OUT of the merged manifest. The source manifest's
         own permission set stays the pinned five asserted by
         PrivacyPolicyTest (which filters these removal markers out of the
         declared-set pin and asserts the removal set exactly, in its own
         dedicated r24 test). -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- Phase 3 grid UX (issue #33): the Application registers Coil's
         VideoFrameDecoder for video thumbnails; see ToadGalleryApplication. -->
    <!-- Phase 3 vault (audit finding A): allowBackup stays true so preferences
         and diagnostics remain backable, but the vault (filesDir/vault: PIN
         record, index, sealed blobs, biometric.binding) is excluded from
         cloud backup and device transfer via the rules below: its
         AndroidKeyStore key is non-exportable (a restored ciphertext would be
         permanently unopenable) and its state must not leave the device
         (ADR-0014). -->
    <!-- r29 (Issue #14 gate; the Gallery <-> Edit contract, ADR-0002 /
         ADR-0007): package VISIBILITY for the contract editor. On API 30+
         the PackageManager only sees packages declared here; without this
         element the editor resolution (EditorLaunch.kt) would always answer
         "not installed" on modern devices. Two shapes mirror the two launch
         paths: the contract action (the toadGALLERY Edit prototype) and the
         plain third-party ACTION_EDIT fallback (mime-typed image, exactly
         the fallback intent the code builds). Neither entry is a permission;
         both are visibility declarations.
         r42: EditorLaunch grew the video half of the contract
         (VideoEditActivity, concrete video/mpeg-style mimes) but the
         visibility block stayed image-only (the video queries worked
         only through the package-visibility side effect of the image
         filter). r55 closes that fragility with the explicit video/*
         mirrors of both shapes.
         r55 (the one-launcher unification round): the four
         <package> entries are the Settings "Installed components"
         section's probe surface: the family members the section
         enumerates by applicationId (the three gallery engine-family
         flavors and the editor). Still visibility, never permissions:
         the ADR-0014 gate's pinned permission set is untouched. -->
    <queries>
        <intent>
            <action android:name="org.toadgallery.action.EDIT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="org.toadgallery.action.EDIT" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="video/*" />
        </intent>
        <package android:name="io.github.dukeoftoad.gallery.engine" />
        <package android:name="io.github.dukeoftoad.gallery.semantic" />
        <package android:name="io.github.dukeoftoad.gallery.face" />
        <package android:name="io.github.dukeoftoad.gallery.edit" />
    </queries>

    <application
        android:name=".ToadGalleryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:appCategory="image"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_launcher_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <!-- r55 (the one-launcher unification round): the MAIN/LAUNCHER
             entry moves OFF MainActivity onto an alias whose enabled
             state is a per-flavor manifest placeholder
             (launcherAliasEnabled: defaultConfig true, overridden to
             false in the engine/semantic/face flavors). Exactly ONE
             toadGALLERY icon exists on a device: the canonical basic
             build. The engine-family flavors install LAUNCHER-LESS (the
             "toadGALLERY(2)"-style icon duplication the maintainer
             flagged) and open from the basic build's Settings >
             Installed components section via an explicit component
             intent. MainActivity stays exported for exactly that
             path (EditorLaunch's explicit-ComponentName pattern is the
             in-repo precedent). The alias keeps the launcher metadata
             (label/icon) so the basic icon renders identically to the
             pre-r55 shape; per-flavor label overrides continue to
             resolve (they key on @string/app_launcher_name, which the
             alias references). -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:enabled="${launcherAliasEnabled}"
            android:exported="true"
            android:label="@string/app_launcher_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
