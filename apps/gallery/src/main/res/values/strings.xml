    <!-- Vault biometric + thumbnails (#57/#58) -->
    <!-- Biometric unlock binding (issue #57, ADR-0019): opt-in enrollment via
         a Keystore key that demands a fresh fingerprint/face confirmation for
         every unlock; the PIN stays the primary and fallback path. Biometric
         data never leaves the device (the app never even reads it: the
         system compares, the secure hardware authorizes). Thumbnails (issue
         #58) are decrypted in memory only and relock with the vault. -->
    <string name="vault_biometric_unlock_action">Unlock with biometrics</string>
    <string name="vault_biometric_section_title">Biometric unlock</string>
    <string name="vault_biometric_section_body">Optional. Unlock the vault with your fingerprint or face instead of the PIN. Your biometric data stays in this phone\'s secure hardware and never leaves the device. The PIN always keeps working.</string>
    <string name="vault_biometric_prompt_title">Unlock the hidden vault</string>
    <string name="vault_biometric_prompt_subtitle">Confirm it\'s you to open the vault</string>
    <!-- The prompt's negative button (r10 device fix): androidx.biometric
         REQUIRES non-empty negative text whenever the prompt is not allowed
         to fall back to device credential, which is exactly our case,
         since the CryptoObject-bound BIOMETRIC_WEAK key cannot combine with
         DEVICE_CREDENTIAL. Without it PromptInfo.build() throws
         "Negative text must be set and non-empty." and the app crashes the
         moment the biometric sheet is shown. "Use PIN" is the truthful
         label: the cancel path (ERROR_NEGATIVE_BUTTON) is silent and drops
         the user back on the PIN screen. -->
    <string name="vault_biometric_prompt_negative">Use PIN</string>
    <string name="vault_biometric_enabled">Biometric unlock enabled.</string>
    <string name="vault_biometric_disabled">Biometric unlock turned off.</string>
    <string name="vault_biometric_error">Biometric unlock didn\'t work. Use your PIN instead.</string>
    <string name="vault_biometric_invalidated">Biometric unlock stopped working — your device\'s biometrics changed. Unlock with your PIN, then turn biometric unlock back on.</string>

