<?xml version="1.0" encoding="utf-8"?>
<!-- r19b slice: the Photos tab's folder filter (the roadmap follow-up
     "a catalogue bucket column before the folder chip can be surfaced";
     the r19 Room v5 bucketId/bucketDisplayName columns unblocked it).
     Per the r15 to r19 round convention every NEW UI string lives in
     this dedicated file; the shared strings.xml is untouched so the
     parallel branches merge cleanly. Copy conventions follow
     strings.xml: honest plain-language labels, escaped apostrophes.
     Shared affordances are NOT duplicated: the picker's retry reuses
     state_action_retry and its row counts reuse the album_item_count
     plurals (the move picker's). -->
<resources>

    <!-- The leading folder chip (PhotosFilterChips.kt): its label while
         the folder dimension is INACTIVE, and the picker sheet's clear
         row. Both spell the same "no folder restriction" state. -->
    <string name="photos_filter_folder_all">All folders</string>

    <!-- The folder chip's label while a folder IS selected but its
         display name is unknown to this UI (no such filter writer exists
         today; the defensive label. An honest generic beats a stale
         or fabricated name). -->
    <string name="photos_filter_folder">Folder</string>

    <!-- The picker sheet (a Material 3 modal bottom sheet listing the
         device's media folders the way the move picker does). -->
    <string name="photos_filter_folder_sheet_title">Filter by folder</string>

    <!-- A genuinely empty folder list (distinct from the failure below):
         the query succeeded and found no folders. -->
    <string name="photos_filter_folder_sheet_empty">No folders found on this device.</string>

    <!-- The folder query failed (provider error, permission revoked
         mid-sheet): honest failure copy with the shared retry action;
         never a silent empty list that reads as "no folders". -->
    <string name="photos_filter_folder_sheet_error_title">Couldn\'t load your folders</string>
    <string name="photos_filter_folder_sheet_error_body">Something went wrong while reading your folders. Nothing was changed — your media is safe.</string>
</resources>
