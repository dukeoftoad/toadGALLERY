    <string name="person_action_remove">Remove from person</string>
    <string name="cd_person_overflow">More actions</string>

    <!-- The rename dialog (blank input removes the name — a real action). -->
    <string name="person_rename_title">Rename person</string>
    <string name="person_rename_label">Name</string>
    <string name="person_rename_blank_hint">Leave empty to remove the name</string>
    <string name="person_rename_save">Save</string>

    <!-- The merge dialog. -->
    <string name="person_merge_title">Merge with…</string>
    <string name="person_merge_body">Every face of this person moves into the one you pick. This cannot be undone.</string>

    <!-- The hide confirmation. -->
    <string name="person_hide_title">Hide this person?</string>
    <string name="person_hide_body">They won\'t appear in People anymore. Reset the face index in Settings to start over — that erases the whole index, names included.</string>
    <string name="person_hide_confirm">Hide</string>

