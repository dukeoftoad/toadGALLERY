<?xml version="1.0" encoding="utf-8"?>
<!-- r25 slice: the People UI + cluster management (Workstream 6 of the
     Phase 5 plan) — the People browse screen, the Person detail screen
     with rename/merge/hide/remove, the Albums tab's People section, and
     the "People albums" consent row in the Settings AI section. Same
     copy rules as every round file: honest plain language, escaped
     apostrophes, and the privacy posture spelled out — the ADR-0010
     opt-in rule (off by default) and ADR-0020's on-device model
     delivery mean face clustering and people data never leave the
     device. -->
<resources>

    <!-- The Settings AI-section consent row (ADR-0010: opt-in, off by default). -->
    <string name="settings_people_albums">People albums</string>
    <string name="settings_people_albums_body">Group photos by the faces found by the background index. Clustering runs entirely on this device — people data never leaves your phone. Off by default.</string>

    <!-- The Albums tab's People section. -->
    <string name="albums_people_header">People</string>
    <string name="albums_people_consent_off">People albums are off — enable them in Settings.</string>
    <string name="albums_people_engine_missing">People albums need the AI engine, which is not part of this build.</string>
    <string name="albums_people_not_indexed">No people yet — they appear after the background face index runs (Settings → AI engine).</string>
    <string name="albums_people_all_hidden">Every detected person is hidden. Reset the face index in Settings to start over.</string>
    <string name="albums_people_error">People could not be read.</string>
    <string name="albums_people_see_all">See all</string>

    <!-- The People screen's honest states. -->
    <string name="people_title">People</string>
    <string name="people_unnamed">Unnamed</string>
    <string name="people_state_consent_title">People albums are off</string>
    <string name="people_state_consent_body">Enable People albums in Settings to group your photos by face. Clustering runs entirely on this device — nothing is uploaded.</string>
    <string name="people_state_consent_action">Open Settings</string>
    <string name="people_state_engine_title">AI engine not in this build</string>
    <string name="people_state_engine_body">This build was compiled without the face engine, so people albums cannot run here.</string>
    <string name="people_state_not_indexed_title">No people yet</string>
    <string name="people_state_not_indexed_body">People appear here after the background face index runs. Start it from Settings → AI engine → Start background index.</string>
    <string name="people_state_empty_title">Everyone is hidden</string>
    <string name="people_state_empty_body">Every detected person is currently hidden. Reset the face index in Settings to start over.</string>
    <string name="people_state_error_title">Couldn\'t load people</string>
    <string name="people_corrupt_note">Saved people names could not be read — they were reset.</string>

    <!-- Cluster-management actions + dialogs (Person detail). -->
    <string name="person_detail_fallback_title">Person</string>
    <string name="person_detail_error_title">Couldn\'t load this person</string>
