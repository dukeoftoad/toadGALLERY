<?xml version="1.0" encoding="utf-8"?>
<!-- r60 (the device-feedback round): the model-download progress bars,
     the multi-photo self-test honesty lines, and the About entry row's
     own copy. -->
<resources>
    <!-- The AI card's r60 determinate download line (the r50 indeterminate
         spinner keeps covering the no-progress actions: delete, self-test).
         %1$s = file name, %2$s = bytes so far, %3$s = pinned total,
         %4$d = file index, %5$d = file count. -->
    <string name="settings_ai_progress_downloading">%1$s · %2$s / %3$s · file %4$d of %5$d</string>

    <!-- The hash pass between the last byte and the install: the transfer
         is done, the bar sits at 100%%, the line names the work. -->
    <string name="settings_ai_progress_verifying">%1$s · verifying size + SHA-256…</string>

    <!-- r60 self-test: faces WERE found across the bounded multi-photo
         scan. A plurals resource (the count drives the quantity);
         %1$d = photos scanned, %2$d = faces, %3$d = ms, %4$s = the first
         file with a face. -->
    <plurals name="settings_ai_selftest_hit">
        <item quantity="one">1 face in %3$d ms across %1$d scanned photo(s) — engine OK (first hit: %4$s)</item>
        <item quantity="other">%2$d faces in %3$d ms across %1$d scanned photos — engine OK (first hit: %4$s)</item>
    </plurals>

    <!-- r60 self-test: the scan ran clean and found NO faces — on a
         library of UI screenshots that is the detector working, not
         failing. %1$d = photos scanned, %2$d = ms. -->
    <string name="settings_ai_selftest_no_faces">No faces in %1$d scanned photos — engine verified OK (the models load and run; those photos contain no detectable faces)</string>

    <!-- r60: the About section's entry row. It used to repeat the
         heading\'s own string ("About toadGALLERY" stacked twice read as
         a rendering bug); the row now names the page\'s actual content,
         the same heading/entry split the Project progress section has. -->
    <string name="settings_about_entry">Version, privacy and credits</string>
</resources>
