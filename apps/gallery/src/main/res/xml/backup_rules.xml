<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-API-31 cloud backup rules (android:fullBackupContent).

    The vault (filesDir/vault: PIN record, index, sealed blobs,
    biometric.binding) is excluded from cloud backup: its AndroidKeyStore key
    is non-exportable, so a restored ciphertext would be permanently
    unopenable, and vault state must not leave the device (ADR-0014).
    Everything else (preferences, diagnostics) stays backable.

    r24: the face-index directory (filesDir/face-index: the ML-index SQLite
    store with face embeddings + cluster assignments, and the queue's
    index-state bookkeeping) is excluded too — the manifest's ADR-0020 note
    promises embeddings and indexes never leave the device, and cloud backup
    would carry face-derived biometric-adjacent data off it. Unlike the vault
    nothing is KeyStore-bound (a restore would technically work); it is
    excluded on principle, and the queue re-derives everything on-device if
    the directory is absent.

    r51: the media catalogue database (databases/media_catalogue.db + its
    -wal/-shm siblings) is excluded too — its rows carry EXIF-derived GPS
    coordinates, and the manifest promises the coordinates never leave the
    device (ADR-0014). The catalogue is a rebuildable cache, so a restore
    loses nothing a rescan cannot re-derive.
-->
<full-backup-content>
    <exclude domain="file" path="vault" />
    <exclude domain="file" path="face-index" />
    <!-- fullBackupContent paths take no wildcards: the Room db and its
         WAL/SHM siblings are excluded as three explicit entries. -->
    <exclude domain="database" path="media_catalogue.db" />
    <exclude domain="database" path="media_catalogue.db-wal" />
    <exclude domain="database" path="media_catalogue.db-shm" />
</full-backup-content>
