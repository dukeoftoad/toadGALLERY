<?xml version="1.0" encoding="utf-8"?>
<!--
    API-31+ data extraction rules (android:dataExtractionRules).

    The vault (filesDir/vault: PIN record, index, sealed blobs,
    biometric.binding) is excluded from BOTH cloud backup and device-to-device
    transfer: its AndroidKeyStore key is non-exportable, so a restored
    ciphertext would be permanently unopenable, and vault state must not
    leave the device (ADR-0014). Everything else (preferences, diagnostics)
    stays transferable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault" />
    </device-transfer>
</data-extraction-rules>
