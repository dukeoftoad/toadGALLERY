<?xml version="1.0" encoding="utf-8"?>
<!--
    API-31+ data extraction rules (android:dataExtractionRules).

    The vault (filesDir/vault: PIN record, index, sealed blobs,
    biometric.binding) is excluded from BOTH cloud backup and device-to-device
    transfer: its AndroidKeyStore key is non-exportable, so a restored
    ciphertext would be permanently unopenable, and vault state must not
    leave the device (ADR-0014). Everything else (preferences, diagnostics)
    stays transferable.

    r24: the face-index directory (filesDir/face-index: embeddings, cluster
    assignments, queue bookkeeping) is excluded from BOTH surfaces on the
    same principle as the vault's — face-derived data does not leave the
    device (the ADR-0020 manifest note's "embeddings and indexes never cross
    the network", extended to backup/transfer). A restored copy would
    technically work; the transfer is declined on policy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="face-index" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="face-index" />
    </device-transfer>
</data-extraction-rules>
