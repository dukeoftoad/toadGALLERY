<?xml version="1.0" encoding="utf-8"?>
<!-- r59 (the unified-app round): the UNIFIED flavor's manifest fragment.

     The unified build embeds the editor app's code in-process (the flavor's
     sourceSets compile apps/edit's Kotlin sources verbatim), so the two
     contract launch activities must be DECLARED on this applicationId —
     the gallery's EditorResolver self-match path (r59 EditorIdentity
     extension) resolves them exactly like a separately-installed editor,
     but under io.github.dukeoftoad.gallery.unified.

     DELIBERATELY DIFFERENT from apps/edit's manifest in two ways:

     1. NO `tools:node="remove"` on INTERNET. The edit app hard-strips
        INTERNET because it is a standalone app with no network capability
        at all; the unified app is the GALLERY app (whose ADR-0020 model
        downloader legitimately holds INTERNET) with the editor code
        embedded. The editor CODE still opens no socket of its own (the
        same JVM source-scan rule applies to the editor sources); the
        gallery's egress gates govern the whole process. Re-adding edit's
        strip directive here would remove INTERNET from the entire unified
        app and break the model download.

     2. The activities use FULL class names (io.github.dukeoftoad.gallery.edit.*)
        because this fragment's namespace is the GALLERY's package — the
        edit manifest's `.EditActivity` shorthand resolves against the edit
        module's namespace, which does not exist here.

     The activity-level contract meta-data markers (image = 1, video = 2)
     are the same wire values the standalone editor declares: the gallery's
     version negotiation reads them unchanged, in-process or cross-app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pre-Q MediaStore inserts (the editor's save-copy export): the same
         capped legacy grant the standalone edit app declares. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>

        <!-- The contract image surface (v1 wire), verbatim filters from the
             edit app's manifest. -->
        <activity
            android:name="io.github.dukeoftoad.gallery.edit.EditActivity"
            android:exported="true"
            android:label="@string/editor_app_name">
            <intent-filter>
                <action android:name="org.toadgallery.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
            </intent-filter>

            <meta-data
                android:name="org.toadgallery.contract.EDIT"
                android:value="1" />
        </activity>

        <!-- The contract video surface (v2 wire), verbatim filters. -->
        <activity
            android:name="io.github.dukeoftoad.gallery.edit.video.VideoEditActivity"
            android:exported="true"
            android:label="@string/editor_video_app_name">
            <intent-filter>
                <action android:name="org.toadgallery.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/mp4" />
                <data android:mimeType="video/quicktime" />
                <data android:mimeType="video/3gpp" />
            </intent-filter>

            <meta-data
                android:name="org.toadgallery.contract.EDIT"
                android:value="2" />
        </activity>
    </application>

</manifest>
