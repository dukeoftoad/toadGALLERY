<?xml version="1.0" encoding="utf-8"?>
<!-- The standalone editor APP shell. Contract activities arrive from the :editor:core
     library manifest; this shell carries only the application attributes, the
     application-level contract marker, and the INTERNET hard-strip (the library
     manifest stays strip-free: the unified build keeps the gallery's model-download
     grant). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- HARD STRIP: the onnxruntime AAR manifest declares INTERNET; never an allowlist. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:appCategory="image"
        android:icon="@mipmap/editor_ic_launcher"
        android:roundIcon="@mipmap/editor_ic_launcher_round"
        android:label="@string/editor_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <!-- Application-level contract marker: the fallback the hardened gallery
             resolver reads when the activity-level meta-data is unavailable. -->
        <meta-data
            android:name="org.toadgallery.contract.EDIT"
            android:value="2" />
    </application>
</manifest>
