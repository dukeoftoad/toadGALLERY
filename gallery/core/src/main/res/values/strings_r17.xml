<resources>
    <!-- r17 round: smart-filter chips (Photos timeline) + Collections (Albums).
         Kept in a dedicated file so the parallel rounds never touch the shared
         strings.xml; names are prefixed photos_filter_* / albums_collections_* /
         state_photos_filtered_* to stay collision-free. -->

    <!-- Photos timeline filter chips (PhotosFilterChips.kt). The media-type
         labels are shared with the Albums Collections section cards. -->
    <string name="photos_filter_all">All</string>
    <string name="photos_filter_photos">Photos</string>
    <string name="photos_filter_videos">Videos</string>
    <string name="photos_filter_gifs">GIFs</string>
    <string name="photos_filter_favorites">Favorites</string>
    <!-- The explicit clear-all action shown while any filter chip is active. -->
    <string name="photos_filter_clear">Clear</string>

    <!-- Empty result under an ACTIVE filter (distinct from the clean-library
         empty state in strings.xml: the library may be full, the filters
         matched nothing). -->
    <string name="state_photos_filtered_empty_title">Nothing matches</string>
    <string name="state_photos_filtered_empty_body">No photos or videos match the selected filters. Try clearing a chip or two.</string>

    <!-- Albums tab: the Collections section (derived, zero-persistence views
         over the timeline; see DerivedCollections.kt). -->
    <string name="albums_collections_header">Collections</string>
    <string name="albums_collections_subtitle">Smart views of your timeline — nothing is stored</string>
    <!-- Confirmation when a collection card hands its filter to the Photos
         tab (%1$s is the collection name, e.g. "Videos"). -->
    <string name="albums_collection_applied">%1$s filter applied — open the Photos tab to view</string>
</resources>
