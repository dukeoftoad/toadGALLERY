<?xml version="1.0" encoding="utf-8"?>
<!-- r19 round: honest error states for the Albums screens (the UI audit's
     uncaught MediaStore failure class: AlbumsViewModel.reload and
     AlbumDetailViewModel.load escaped viewModelScope uncaught, and
     FileOpsViewModel.refreshAlbums crashed mid Move dialog). Per the
     r15 to r17 round convention every NEW UI string lives in this dedicated
     file; the shared strings.xml is untouched so the parallel branches
     merge cleanly. Copy conventions follow strings.xml: honest
     plain-language states, escaped apostrophes. The retry affordance is
     NOT duplicated: the shared state_action_retry serves it. -->
<resources>

    <!-- Albums tab error state (a provider failure in
         AlbumsViewModel.reload maps to AlbumsState.Error; rendered via the
         shared ErrorState component, whose first live call sites are this
         one and the album detail error below). -->
    <string name="state_albums_error_title">Couldn\'t load your albums</string>
    <string name="state_albums_error_body">Something went wrong while reading your albums. Nothing was changed — your media is safe.</string>

    <!-- Album detail error state (a provider failure in
         AlbumDetailViewModel.load maps to AlbumDetailState.Error instead of
         the pre-r19 fake "empty folder"; tag album_detail_state_error is
         reserved in docs/architecture/screen-states.md §2). -->
    <string name="album_detail_error_title">Couldn\'t load this album</string>
    <string name="album_detail_error_body">Something went wrong while reading this album. Nothing was changed — your media is safe.</string>

    <!-- Move-picker album-list failure (FileOpsViewModel.refreshAlbums):
         narrated through the existing file-ops snackbar event channel; the
         picker itself falls back to its empty (no-targets) list so it
         never spins forever. -->
    <string name="file_ops_albums_failed">Couldn\'t load the album list — nothing was changed. Close and reopen the picker to retry.</string>
</resources>
