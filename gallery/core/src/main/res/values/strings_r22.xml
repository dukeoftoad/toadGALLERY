<?xml version="1.0" encoding="utf-8"?>
<!-- r22 slice: the Settings "AI engine (r22 dogfood)" section — the
     maintainer's window into the ADR-0020 model-delivery path (the real
     allowlisted-host download, deletion, and one JNI inference self-test).
     Per the r15 to r19 round convention every NEW UI string lives in this
     dedicated file; the shared strings.xml is untouched so the parallel
     branches merge cleanly. Copy conventions follow strings.xml: honest
     plain-language labels, escaped apostrophes. The allowlisted HOST is
     deliberately NOT spelled here — ml/engine/HttpModelDownloader.kt's
     MODEL_HOST is the one auditable host literal (pinned by
     PrivacyPolicyTest), and user copy never duplicates it. -->
<resources>

    <!-- Section header + one-line honest description (a developer
         section; no user-facing feature consumes the engine yet). -->
    <!-- r50 (the UI/UX polish round): the round-tag jargon is gone from the
         USER-FACING section title. -->
    <string name="settings_ai_section">AI engine</string>
    <string name="settings_ai_section_body">Developer section: downloads the pinned face models from the single allowlisted model host (size and SHA-256 verified before install) and exercises the on-device engine. No other network traffic exists.</string>

    <!-- Engine library presence: the .so ships only in engine builds. -->
    <string name="settings_ai_library_present">Engine library: present (engine build)</string>
    <string name="settings_ai_library_missing">Engine library: not in this build (build with the engine flag)</string>

    <!-- The FACE capability's provisioner-derived state line. -->
    <string name="settings_ai_state_none">Face models: not downloaded</string>
    <string name="settings_ai_state_partial">Face models: partially downloaded</string>
    <string name="settings_ai_state_ready">Face models: ready</string>

    <!-- Per-asset presence rows (manifest file names render verbatim). -->
    <string name="settings_ai_asset_installed">installed</string>
    <string name="settings_ai_asset_missing">missing</string>

    <!-- Actions. The size is ADR-0020's FACE figure (37,633,894 bytes). -->
    <string name="settings_ai_download">Download face models (~36 MiB)</string>
    <string name="settings_ai_delete">Delete face models</string>
    <string name="settings_ai_selftest">Run engine self-test</string>

    <!-- Download/delete outcomes; the failure line carries the
         provisioner's own message (file + reason), unparaphrased. -->
    <string name="settings_ai_download_done">Face models installed and verified.</string>
    <string name="settings_ai_download_failed">Download failed: %1$s</string>
    <string name="settings_ai_deleted">Face models deleted.</string>

    <!-- Self-test outcomes. The OK line is "file: N faces in X ms". -->
    <string name="settings_ai_selftest_library_missing">Engine library not in this build (build with the engine flag).</string>
    <string name="settings_ai_selftest_no_jpeg">No JPEG on this device to test with.</string>
    <string name="settings_ai_selftest_failed">Self-test failed: %1$s</string>
    <plurals name="settings_ai_selftest_faces">
        <item quantity="one">%1$s: 1 face in %3$d ms — engine OK</item>
        <item quantity="other">%1$s: %2$d faces in %3$d ms — engine OK</item>
    </plurals>
</resources>
